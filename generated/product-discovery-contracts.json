    {
      "number": "006",
      "id": "sec-filing-freshness",
      "resource": {
        "path": "/api/sec-filing-freshness",
        "method": "GET",
        "description": "Check whether a U.S. public filer has an SEC EDGAR filing matching an optional form filter within a caller-selected freshness window. Returns recent_filing, no_recent_filing, or company_not_found from authoritative SEC metadata; it does not interpret filing contents or provide investment advice.",
        "serviceName": "SEC Filing Freshness Check",
        "tags": [
          "SEC",
          "EDGAR",
          "filing-freshness",
          "company-data",
          "agent-decision"
        ],
        "price": "$0.005",
        "accepts": [
          {
            "scheme": "exact",
            "network": "eip155:8453",
            "amount": "5000",
            "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
            "payTo": "0x708f7b52b56eafd7fc1de65fc7752ed732914021",
            "maxTimeoutSeconds": 60,
            "extra": {
              "name": "USD Coin",
              "version": "2"
            }
          }
        ],
        "extensions": {
          "bazaar": {
            "info": {
              "input": {
                "type": "http",
                "method": "GET",
                "queryParams": {
                  "ticker": "AAPL",
                  "maxAgeDays": 30
                }
              },
              "output": {
                "type": "json",
                "example": {
                  "decision": "recent_filing",
                  "paid": true
                }
              }
            }
          }
        }
      },
      "openapi": {
        "get": {
          "operationId": "checkSecFilingFreshness",
          "summary": "Check SEC filing freshness for a public filer",
          "description": "Resolve a U.S. public filer by ticker or CIK and determine whether SEC EDGAR contains a matching filing inside a caller-selected freshness window. Optional form filtering is exact (for example 8-K, 10-Q, 10-K). Returns recent_filing, no_recent_filing, or company_not_found. The endpoint reports metadata only and does not interpret filing contents or provide investment advice.",
          "tags": [
            "SEC",
            "EDGAR",
            "Filing Freshness",
            "Company Data"
          ],
          "parameters": [
            {
              "name": "ticker",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "example": "AAPL"
            },
            {
              "name": "cik",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "pattern": "^\\d{1,10}$"
              }
            },
            {
              "name": "form",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "maxLength": 20
              }
            },
            {
              "name": "maxAgeDays",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365,
                "default": 30
              },
              "example": 30
            }
          ],
          "x-payment-info": {
            "price": {
              "mode": "fixed",
              "currency": "USD",
              "amount": "0.005000"
            },
            "protocols": [
              {
                "x402": {}
              }
            ],
            "network": "eip155:8453",
            "payTo": "0x708f7b52b56eafd7fc1de65fc7752ed732914021"
          },
          "responses": {
            "200": {
              "description": "Completed paid result."
            },
            "400": {
              "description": "Invalid input; payment is not settled."
            },
            "402": {
              "description": "Payment required or terminally invalid."
            },
            "502": {
              "description": "Required source unavailable; payment is not settled."
            },
            "503": {
              "description": "Payment state unresolved; retry the same payment authorization."
            }
          },
          "x-input-rule": "Provide exactly one of ticker or cik."
        }
      }
